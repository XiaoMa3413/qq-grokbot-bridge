# Copy to .env on the bridge host. Keep secrets out of Git and chat.
QQ_APP_ID=
QQ_APP_SECRET=
QQ_FORWARD_WEBHOOK_URL=
QQ_FORWARD_WEBHOOK_SECRET=
# Set only if the existing Grok webhook requires a non-Bearer header.
# QQ_FORWARD_WEBHOOK_HEADER=X-Automation-Key
QQ_REPLY_PORT=8787
# Full external HTTPS reply endpoint; setting this enables remote text-only mode.
QQ_REPLY_PUBLIC_URL=
# Optional shared secret (32+ characters). Otherwise generated in reply_token.
# QQ_REPLY_TOKEN=
